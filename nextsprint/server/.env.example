# Copy to .env and fill in
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
# Optional: where the SQLite file lives (defaults to ./nextsprint.db)
# On Render with a persistent disk, set this to /var/data/nextsprint.db
DB_PATH=
# Optional: comma-separated allowed origins for CORS (defaults to allow all)
CLIENT_ORIGIN=http://localhost:5173
